<idea-plugin>
    <id>com.codexgui.jetbrains</id>
    <name>CodeDeck</name>
    <vendor>CodeDeck</vendor>

    <description><![CDATA[
      面向 JetBrains IDE 的 Codex / Claude Code 图形界面。连接 Codex app-server 与
      Claude Code CLI，不注入第三方隐藏提示词。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="CodeDeck"
                    anchor="right"
                    icon="/icons/codex.svg"
                    factoryClass="com.codexgui.ui.CodexToolWindowFactory"
                    canCloseContents="false"/>
        <applicationConfigurable id="com.codexgui.settings"
                                 parentId="tools"
                                 displayName="CodeDeck"
                                 instance="com.codexgui.settings.CodexSettingsConfigurable"/>
        <applicationService serviceImplementation="com.codexgui.settings.CodexSettingsState"/>
        <projectService serviceImplementation="com.codexgui.service.CodexAppServerService"/>
        <projectService serviceImplementation="com.codexgui.service.ClaudeCodeService"/>
        <projectService serviceImplementation="com.codexgui.service.ClaudeHookRelayService"/>
        <projectService serviceImplementation="com.codexgui.service.ConversationChangeTracker"/>
        <projectService serviceImplementation="com.codexgui.settings.CodexProjectSettingsState"/>
        <notificationGroup id="CodeDeck Notifications"
                           displayType="BALLOON"
                           isLogByDefault="false"/>
    </extensions>
</idea-plugin>
